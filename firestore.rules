rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // A Firebase Auth UID is also the owner document ID. A user can never
    // enumerate another user's profile or subcollections.
    match /users/{userId} {
      allow create: if ownsUser(userId) && request.resource.data.uid == userId;
      allow read: if ownsUser(userId);
      allow update: if ownsUser(userId) && request.resource.data.uid == userId;
      allow delete: if ownsUser(userId);

      // Products, customers, categories, sales, activity logs, carts, drafts,
      // and any future business subcollection inherit the same tenant boundary.
      match /{document=**} {
        allow read, write: if ownsUser(userId);
      }
    }

    // Legacy top-level collections and every other unrecognised path are
    // deliberately inaccessible from clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
